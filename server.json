{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.1shizaan/debugai-mcp",
  "description": "MCP server for DebugAI. Browser sign-in, auto client setup, no key pasting.",
  "repository": {
    "url": "https://github.com/1shizaan/debugai-mcp",
    "source": "github"
  },
  "version": "2.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@debugai/mcp",
      "version": "2.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Optional. Overrides browser sign-in (npx -y @debugai/mcp setup).",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "DEBUGAI_API_KEY"
        }
      ]
    }
  ]
}